# Copy to .env and fill in. .env is gitignored; this example is safe to commit.
# These are PLACEHOLDERS, not real keys.

# Daraja AI translation API key — required for the default 'daraja' engine.
# Get one at https://daraja.ai
DARAJA_API_KEY=<your-daraja-api-key>

# --- Optional: LLM-as-judge / `llm:` engines ---------------------------------
# Only set the key for the provider you actually use.
# OPENAI_API_KEY=<your-openai-api-key>
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# GOOGLE_API_KEY=<your-google-api-key>
# Ollama runs locally and needs no key — just a running `ollama serve`.
